{
  "manifest_version": 3,
  "name": "UnLink — nettoyage LinkedIn en 1 clic",
  "short_name": "UnLink",
  "version": "1.0.0",
  "description": "Désabonnement, retrait de relation et suppression de conversation LinkedIn en un raccourci. Met en évidence les relances sans réponse.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "UnLink",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "src/options/options.html",
  "commands": {
    "run-cleanup": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "Alt+Shift+U"
      },
      "description": "Nettoyer la conversation ouverte (désabo / retrait de relation / suppression)"
    },
    "next-flagged": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Aller à la prochaine conversation en relance"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/content/net-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/shared/settings.js",
        "src/shared/stats.js",
        "src/shared/exclusions.js",
        "src/content/store.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "src/shared/labels.js",
        "src/shared/dom.js",
        "src/content/ui.js",
        "src/content/api.js",
        "src/content/profile.js",
        "src/content/history.js",
        "src/content/messaging.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "homepage_url": "https://github.com/The-Forge-Agency/unlink"
}
